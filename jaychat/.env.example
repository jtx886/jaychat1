# Jay Chat 服务端环境变量
# 用法：复制为 .env（install.sh 会自动生成），按需修改后 docker compose up -d
# 说明：留空的项会使用 server/src/config.js 中的内置默认值

# ---- 鉴权 ----
# 生产环境务必改成随机长字符串（install.sh 会自动生成一个）
JWT_SECRET=

# 开发模式：false 时验证码不再随接口返回明文（正式环境请保持 false）
DEV_MODE=false

# ---- 163 邮箱验证码（SMTP）----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=jtxnb886@163.com
SMTP_PASS=FLLRDtadYAfGXp9Y
SMTP_FROM=jtxnb886@163.com
SMTP_FROM_NAME=Jay Chat

# ---- 腾讯云 IM ----
IM_SDKAPPID=1600167563
IM_SECRETKEY=905e603b25e4407fc8996a45df3ecee66f098c38b3313031b2d82c8426ef16ba

# ---- Jay AI（智谱 GLM）----
AI_KEY=d63d18de6bcf4a92a13a78696e401e83.0MIXAf8ANp2tG9BD
AI_MODEL=glm-4-flash

# ---- 可选：启用 Caddy 自动 HTTPS 时填写域名 ----
DOMAIN=
