<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".JayChatApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.JayChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />

        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PostMomentActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AddFriendActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.StickersActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />

        <activity
            android:name=".ui.ServerSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CreateGroupActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.GroupInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FriendInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />

        <activity
            android:name=".ui.BlacklistActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />

        <activity
            android:name=".ui.MomentDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.UserMomentsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />
    </application>
</manifest>
