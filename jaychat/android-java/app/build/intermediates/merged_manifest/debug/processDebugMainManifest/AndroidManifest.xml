<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jaychat.app"
    android:versionCode="13"
    android:versionName="3.0.3" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.jaychat.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.jaychat.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.jaychat.app.JayChatApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.JayChat"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.jaychat.app.AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.jaychat.app.ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />
        <activity
            android:name="com.jaychat.app.ui.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.PostMomentActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.AddFriendActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.StickersActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />
        <activity
            android:name="com.jaychat.app.ui.ServerSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.CreateGroupActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.GroupInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.FriendInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />
        <activity
            android:name="com.jaychat.app.ui.BlacklistActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />
        <activity
            android:name="com.jaychat.app.ui.MomentDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.jaychat.app.ui.UserMomentsActivity"
            android:exported="false"
            android:theme="@style/Theme.JayChat" />

        <meta-data
            android:name="com.bumptech.glide.integration.okhttp3.OkHttpGlideModule"
            android:value="GlideModule" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.jaychat.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>