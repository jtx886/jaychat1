<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="26dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <com.jaychat.app.AvatarView
                android:id="@+id/avatar"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_glass"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/rowProfile"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="编辑资料" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowStickers"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_emoji"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="表情包" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMyMoments"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_moments"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="我的动态" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowBlacklist"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="黑名单" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowNotifications"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="通知" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAdmin"
                style="@style/MenuRow"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/warn" />

                <TextView
                    style="@style/MenuText"
                    android:text="后台管理" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowServer"
                style="@style/MenuRow">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/brand2" />

                <TextView
                    style="@style/MenuText"
                    android:text="服务器设置" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnLogout"
            style="@style/GhostButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="退出登录"
            android:textColor="@color/danger" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/text3"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
