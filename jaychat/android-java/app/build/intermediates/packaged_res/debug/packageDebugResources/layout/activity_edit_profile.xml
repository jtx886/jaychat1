<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="编辑资料"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <com.jaychat.app.AvatarView
                    android:id="@+id/avatar"
                    android:layout_width="92dp"
                    android:layout_height="92dp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text3"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点击头像上传本地图片，或选择下方预设头像"
                    android:textColor="@color/text3"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/presetRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="昵称（1-6 个字符，每周最多修改 2 次）"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etName"
                    style="@style/Edit"
                    android:layout_marginTop="8dp"
                    android:hint="输入昵称"
                    android:maxLength="6"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="个性签名（最多 60 字）"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etBio"
                    style="@style/Edit"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:hint="介绍一下自己…"
                    android:maxLength="60"
                    android:maxLines="3"
                    android:minHeight="76dp"
                    android:singleLine="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSave"
                style="@style/BrandButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="保存修改" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
