# 部分共享主机（FastCGI/CGI）会剥离 Authorization 头，这里显式回填，
# 保证 Bearer token 鉴权可用（index.php 也支持 ?token= 兜底）。
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# 安全响应头（静态资源也生效；动态接口由 index.php 再输出一份）
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=()"
  Header always unset X-Powered-By
</IfModule>

# 文本类响应开启 gzip：主 JS 约 570KB → 250KB，免费主机带宽小，首屏提速明显
# 注意：不对 application/json 压缩——长轮询是挂起的流式请求，输出过滤器会缓冲它
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/xml image/svg+xml
</IfModule>

# 带 hash 的构建产物长缓存：二次访问不再重新下载，秒开
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
<FilesMatch "\.(js|css|svg)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) 敏感目录与隐藏文件一律拒绝（lib 内含数据库配置，绝不可被直接访问）
  RewriteRule ^(lib|database)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # 2) API 统一交给 index.php 分发（/api、/api/、/api/health ...）
  RewriteRule ^api(/|$) index.php [L,QSA]

  # 3) 入口页面也走 index.php，确保被封禁 IP 无法打开站点
  RewriteRule ^index\.html$ index.php [L]

  # 4) 已存在的文件/目录直接访问（/uploads/*、/assets/*、前端构建产物）
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5) 其余任意路径 → SPA 前端路由兜底
  RewriteRule ^ index.php [L]
</IfModule>

# 首页优先由 PHP 处理（用于 IP 黑名单拦截）
DirectoryIndex index.php index.html

# index.html 禁止缓存：升级部署后浏览器/WebView 必须立刻拿到新的资源清单，
# 否则会继续用旧 JS，表现为「部署了修复但问题依旧」。
<FilesMatch "^(index\.html)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# 禁止目录列出
Options -Indexes

# 禁止 TRACE 等危险方法
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>
